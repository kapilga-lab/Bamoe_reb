<?xml version="1.0" encoding="UTF-8"?>
<!--
  Oracle-only JPA mapping overrides for BAMOE bugs (present in 9.4.2, re-checked in 9.5.2-ibm-0002):
  the Oracle kie-flyway scripts rename columns that are Oracle reserved words, but the shipped
  entities keep the H2/PostgreSQL column names, so the generated SQL fails with ORA-01747.

  1. jbpm-addons-usertask-storage-jpa: DDL column TASK_COMMENT vs CommentEntity.comment.
  2. kogito-addons-common-embedded-jobs-jpa: DDL column JOB_TRIGGER vs JobDetailsEntity.trigger
     (fails on every embedded Jobs Service poll).

  Activated by OracleOrmMappingPostProcessor only when the datasource is Oracle. Remove once
  the entities carry @Column(name = "task_comment" / "job_trigger").
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                                     https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">
  <entity class="org.jbpm.usertask.jpa.model.CommentEntity">
    <attributes>
      <basic name="comment">
        <column name="task_comment"/>
      </basic>
    </attributes>
  </entity>
  <entity class="org.kie.kogito.app.jobs.jpa.model.JobDetailsEntity">
    <!-- Re-state the converter so the column override cannot suppress the annotation. -->
    <convert attribute-name="trigger"
             converter="org.kie.kogito.app.jobs.jpa.converter.JsonBinaryConverter"/>
    <attributes>
      <basic name="trigger">
        <column name="job_trigger"/>
      </basic>
    </attributes>
  </entity>
</entity-mappings>
